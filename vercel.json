{
  "functions": {
    "api/m3u.js": {
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/api/m3u",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
